generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdeaStatus {
  COMMITTED
  EXPLORING
  OPEN
}

enum FullTimeTimeline {
  ALREADY_FULLTIME
  READY_WHEN_RIGHT
  NEXT_YEAR
  NO_PLANS
}

enum Importance {
  REQUIRED
  VERY_IMPORTANT
  SOMEWHAT_IMPORTANT
  NOT_IMPORTANT
}

model User {
  id               String   @id @default(cuid())
  clerkId          String   @unique
  email            String   @unique
  university       String
  universityDomain String

  // Profile completion tracking
  agreedToTerms Boolean @default(false)
  profileStep   Int     @default(0)

  // ── Step 1: Basics ────────────────────────────────────────────
  firstName     String?
  lastName      String?
  linkedinUrl   String?
  location      String?
  bio           String?   @db.Text
  accomplishment String?  @db.Text
  education     String?   @db.Text
  employment    String?   @db.Text
  isTechnical   Boolean?
  gender        String?
  birthdate     DateTime?
  schedulingUrl String?
  twitterUrl    String?
  instagramUrl  String?

  // ── Step 2: More About You ────────────────────────────────────
  ideaStatus        IdeaStatus?
  ideaDescription   String?   @db.Text
  hasCofounder      Boolean?
  fullTimeTimeline  FullTimeTimeline?
  startupAreas      String[]
  interestedTopics  String[]
  equityExpectation String?
  hobbies           String?   @db.Text
  lifePath          String?   @db.Text
  anythingElse      String?   @db.Text

  // ── Step 3: Co-Founder Preferences ────────────────────────────
  lookingFor              String?   @db.Text
  prefIdeaStatus          String?
  prefIdeaImportance      Importance?
  prefTechnical           String?
  prefTechnicalImportance Importance?
  prefTimingMatch         String?
  prefLocationMatch       String?
  prefLocationImportance  Importance?
  prefAgeMin              Int?
  prefAgeMax              Int?
  prefAgeImportance       Importance?
  prefCofounderAreas      String[]
  prefAreasImportance     Importance?
  prefInterestMatch       String?
  prefSchoolMatch         String?
  alertOnMatch            Boolean @default(false)

  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([universityDomain])
}
